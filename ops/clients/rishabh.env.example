# Rishabh Plastic: copy to ops/clients/rishabh.env and fill in the secrets (that file is not committed).
CLIENT_ID=rishabh
CLIENT_NAME=Rishabh Plastic
COMPANY_SCHEMA=rishabh_plastic27

# Version of the app images (a tag from the registry). "local" = images built by: ops/smartwinfa.sh build-local
SMARTWINFA_VERSION=local
SMARTWINFA_WEB_IMAGE=smartwinfa-web
SMARTWINFA_API_IMAGE=smartwinfa-legacy-api

DB_PASSWORD=change-me
WEB_PORT=4101
WEB_BIND=127.0.0.1

# The client's PostgreSQL custom dump, restored on the first start. Leave SEED_FILE empty to start with an empty database.
SEED_DIR=../../database/fixtures/private
SEED_FILE=rishabh-plastic27.dump

# Saving is off until the client is live.
SMARTWINFA_MASTER_WRITES=false
SMARTWINFA_ENTRY_WRITES=false
# Development only. Never true on a client server.
SMARTWINFA_TRUSTED_LOCAL_MODE=false

BACKUP_HOUR=2
BACKUP_KEEP_DAYS=14

# ---- Site kit (only for a client that keeps SMARTwinFA on their own machine; see ops/site/compose.yaml) ----
# Filled by: ops/smartwinfa.sh fleet enroll <id>  (on your control panel), then copy this file to the client's box.
EDGE_ID=
EDGE_KEY=
EDGE_INSECURE_POLL=0
# on = your support agent runs; the client can switch it off: ops/smartwinfa.sh site support off <id>
SUPPORT_MODE=on
LOKI_PUSH_URL=
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
# Cloudflare Tunnel token for https://<client>.your-domain.com (Zero Trust > Networks > Tunnels)
SITE_TUNNEL_TOKEN=
# Offsite copies of the nightly backups (Cloudflare R2: endpoint https://<account>.r2.cloudflarestorage.com)
OFFSITE_PROVIDER=Cloudflare
OFFSITE_ENDPOINT=
OFFSITE_BUCKET=
OFFSITE_ACCESS_KEY_ID=
OFFSITE_SECRET_ACCESS_KEY=
