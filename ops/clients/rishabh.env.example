# Rishabh Plastic: copy to ops/clients/rishabh.env and fill in the secrets (that file is not committed).
CLIENT_ID=rishabh
CLIENT_NAME=Rishabh Plastic
COMPANY_SCHEMA=rishabh_plastic27

# Version of the app images (a tag from the registry). "local" = images built by: ops/smartwinfa.sh build-local
SMARTWINFA_VERSION=local
SMARTWINFA_WEB_IMAGE=smartwinfa-web
SMARTWINFA_API_IMAGE=smartwinfa-legacy-api

DB_PASSWORD=change-me
WEB_PORT=4101
WEB_BIND=127.0.0.1

# The client's PostgreSQL custom dump, restored on the first start. Leave SEED_FILE empty to start with an empty database.
SEED_DIR=../../database/fixtures/private
SEED_FILE=rishabh-plastic27.dump

# Saving is off until the client is live.
SMARTWINFA_MASTER_WRITES=false
SMARTWINFA_ENTRY_WRITES=false
# Development only. Never true on a client server.
SMARTWINFA_TRUSTED_LOCAL_MODE=false

BACKUP_HOUR=2
BACKUP_KEEP_DAYS=14
