# The staff site (e.g. https://admin.smartwinfa.com): one address for the fleet tools. Each tool keeps its own sign-in;
# no password is added here, because Portainer and Grafana use the Authorization header themselves. Gate the address
# with Cloudflare Access (staff only, with MFA) instead.
#   /, /panel/*   the control panel (a card per client; its own sign-in)
#   /grafana/     logs of every client (Grafana serves itself from this sub-path)
#   /portainer/   every stack and container (the prefix is taken off; Portainer's pages use relative paths)
#   anything else Uptime Kuma (it cannot run under a sub-path, so it has the rest: /dashboard, /status ...)
# Plain HTTP on :80: Cloudflare (or the host's nginx) gives the address its HTTPS.
{
	auto_https off
	admin off
}

:80 {
	encode gzip

	redir /grafana /grafana/
	handle /grafana/* {
		reverse_proxy grafana:3000
	}

	redir /portainer /portainer/
	handle_path /portainer/* {
		reverse_proxy portainer:9000
	}

	handle / {
		reverse_proxy panel:8080
	}
	handle /panel/* {
		reverse_proxy panel:8080
	}

	handle {
		reverse_proxy uptime-kuma:3001
	}
}
