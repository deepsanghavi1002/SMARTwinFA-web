FLEET_BIND=127.0.0.1
GRAFANA_ADMIN_PASSWORD=change-me
# The staff site's public address (Grafana's links use it) and its port on this host (publish http://smartwinfa-admin:80 in the tunnel).
ADMIN_URL=http://localhost:9090
ADMIN_PORT=9090
# The host port of Portainer's edge tunnel, when 8000 is already in use on this machine.
PORTAINER_EDGE_PORT=8000
# TUNNEL_TOKEN=paste the token from Cloudflare Zero Trust > Networks > Tunnels

# Where on-prem site agents reach this control panel (used by: ops/smartwinfa.sh fleet enroll <id>).
# Local demo defaults below; in production e.g. https://ops.your-domain.com and edge.your-domain.com:443
PORTAINER_EDGE_URL=http://smartwinfa-fleet-portainer-1:9000
PORTAINER_EDGE_TUNNEL=smartwinfa-fleet-portainer-1:8000
# Where site log agents push logs (production: https://logs-in.your-domain.com/loki/api/v1/push behind a Cloudflare Access service token)
LOKI_PUSH_URL=http://smartwinfa-fleet-loki-1:3100/loki/api/v1/push
