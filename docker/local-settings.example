# Copy this file to .env.docker before starting the local Docker stack.
COMPOSE_PROJECT_NAME=smartwinfa-local
SMARTWINFA_WEB_PORT=3000
SMARTWINFA_POSTGRES_PORT=5432
SMARTWINFA_DB_PASSWORD=smartwinfa-local-dev

# Name of the approved PostgreSQL custom dump stored locally in
# database/fixtures/private/. This file is never committed.
SMARTWINFA_COMPANY_DUMP=mock-company.dump
LEGACY_COMPANY_SCHEMA=smartwinfa_demo
SMARTWINFA_MASTER_WRITES=true
SMARTWINFA_ENTRY_WRITES=true
SMARTWINFA_RELEASE=local-test
